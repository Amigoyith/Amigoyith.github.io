---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import headshot from '../assets/headshot.jpg';
import { profile, skills } from '../site';

const experience = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
const featured = (await getCollection('projects'))
  .filter((p) => p.data.featured && !p.id.includes('/'))
  .sort((a, b) => a.data.order - b.data.order);

const stats = [
  { n: '6', label: 'avionics display panels taken to production release' },
  { n: '450+', label: 'hardware requirements authored in DOORS' },
  { n: '0.05%', label: 'speed error on my interrupt-driven motor encoder' },
  { n: '0', label: 're-spins on my JTAG adapter board' },
];
---
<Base>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">{profile.role}</span>
        <h1>Hi, I'm Amy. I build hardware that ships.</h1>
        <p class="tagline">{profile.tagline}</p>
        <p class="mono muted where">{profile.school} · {profile.location}</p>
        <div class="actions">
          <a class="btn primary" href="/resume/">View resume</a>
          <a class="btn" href={`mailto:${profile.email}`}>Email me</a>
          <a class="btn" href={profile.linkedin}>LinkedIn</a>
          <a class="btn" href={profile.github}>GitHub</a>
        </div>
      </div>
      <div class="portrait">
        <Image src={headshot} alt={`Portrait of ${profile.name}`} width={520} loading="eager" />
      </div>
    </div>
  </section>

  <section class="container stats" aria-label="At a glance">
    {stats.map((s) => (
      <div class="stat">
        <span class="n">{s.n}</span>
        <span class="l">{s.label}</span>
      </div>
    ))}
  </section>

  <section class="section" id="experience">
    <div class="container">
      <div class="section-head">
        <h2>Experience</h2>
        <span class="mono muted">Click a card for photos and details</span>
      </div>
      <div class="grid">
        {experience.map((e) => (
          <Card
            href={`/experience/${e.id}/`}
            eyebrow={e.data.kind}
            title={e.data.org}
            meta={`${e.data.title} · ${e.data.dates}`}
            summary={e.data.summary}
            tags={e.data.tags}
            cover={e.data.cover}
            coverAlt={e.data.coverAlt}
            placeholder={e.data.short ?? e.data.org}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="projects">
    <div class="container">
      <div class="section-head">
        <h2>Selected projects</h2>
        <a class="mono" href="/projects/">All projects →</a>
      </div>
      <div class="grid">
        {featured.map((p) => (
          <Card
            href={`/projects/${p.id}/`}
            eyebrow="Project"
            title={p.data.title}
            meta={p.data.context}
            summary={p.data.summary}
            tags={p.data.tags}
            cover={p.data.cover}
            coverUrl={p.data.coverUrl}
            coverAlt={p.data.coverAlt}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="skills">
    <div class="container">
      <div class="section-head"><h2>Toolbox</h2></div>
      <div class="skills">
        {skills.map((g) => (
          <div class="skill-group">
            <h3 class="mono">{g.group}</h3>
            <ul class="tags">{g.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container contact">
      <h2>Let's talk</h2>
      <p class="muted">
        I'm looking for full-time roles in hardware design, embedded systems and verification starting in 2027.
      </p>
      <a class="btn primary" href={`mailto:${profile.email}`}>{profile.email}</a>
    </div>
  </section>
</Base>

<style>
  .hero { padding: 64px 0 40px; }
  .hero-grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: 48px; align-items: center; }
  .tagline { font-size: 1.15rem; color: var(--muted); max-width: 40ch; }
  .where { margin-top: 18px; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 26px; }
  .portrait { position: relative; }
  .portrait::before {
    content: ''; position: absolute; inset: 18px -18px -18px 18px;
    border: 2px solid var(--copper); border-radius: 22px; opacity: .55;
  }
  .portrait :global(img) { position: relative; border-radius: 20px; aspect-ratio: 1; object-fit: cover; width: 100%; box-shadow: var(--shadow); }

  .stats {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px;
    background: var(--line); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden;
    margin-top: 24px; padding: 0;
  }
  .stat { background: var(--surface); padding: 20px 22px; display: flex; flex-direction: column; gap: 4px; }
  .stat .n { font-size: 1.9rem; font-weight: 700; color: var(--accent); letter-spacing: -0.02em; }
  .stat .l { font-size: 0.88rem; color: var(--muted); line-height: 1.4; }

  .skills { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 24px; }
  .skill-group h3 { font-size: 0.8rem; text-transform: uppercase; letter-spacing: .1em; color: var(--copper); }

  .contact { text-align: center; max-width: 620px; }

  @media (max-width: 820px) {
    .hero { padding-top: 36px; }
    .hero-grid { grid-template-columns: 1fr; gap: 36px; }
    .portrait { max-width: 260px; order: -1; }
    .stats { grid-template-columns: repeat(2, 1fr); }
  }
</style>
