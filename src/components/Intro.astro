---
// Opening animation on the home page: a clock edge that settles into a sine
// wave, then the overlay lifts away. Plays once per browser session, never for
// reduced-motion users, and the page works without JavaScript (overlay stays hidden).
const W = 1000;
const MID = 60;
const pts: string[] = [`M0 ${MID}`];
// square wave, 0–500
for (let x = 0; x < 500; x += 100) {
  pts.push(`L${x} ${MID - 36}`, `L${x + 50} ${MID - 36}`, `L${x + 50} ${MID + 36}`, `L${x + 100} ${MID + 36}`);
}
// sine wave, 500–1000
for (let x = 500; x <= W; x += 4) {
  pts.push(`L${x} ${(MID - 36 * Math.sin(((x - 500) / 100) * 2 * Math.PI + Math.PI / 2)).toFixed(1)}`);
}
const d = pts.join(' ');
---
<div class="intro-overlay" aria-hidden="true">
  <div class="intro-inner">
    <svg viewBox="-10 0 1020 120" preserveAspectRatio="none">
      <line class="axis" x1="0" y1="60" x2="1000" y2="60" />
      <path class="trace" d={d} pathLength="1" />
    </svg>
    <p class="intro-name">Xiyuan (Amy) Liu</p>
    <p class="intro-sub">hardware · embedded · signals</p>
  </div>
  <button class="intro-skip" type="button">Skip</button>
</div>

<script is:inline>
  (function () {
    var root = document.documentElement;
    if (!root.classList.contains('intro')) return;
    var overlay = document.querySelector('.intro-overlay');
    var done = function () {
      root.classList.add('intro-out');
      setTimeout(function () { root.classList.remove('intro', 'intro-out'); }, 700);
    };
    var t = setTimeout(done, 2600);
    overlay.querySelector('.intro-skip').addEventListener('click', function () { clearTimeout(t); done(); });
    overlay.addEventListener('click', function () { clearTimeout(t); done(); });
  })();
</script>

<style is:global>
  .intro-overlay { display: none; }
  html.intro { overflow: hidden; }
  html.intro .intro-overlay {
    display: grid; place-items: center; position: fixed; inset: 0; z-index: 100;
    background: var(--bg); cursor: pointer;
    transition: transform .7s cubic-bezier(.7, 0, .2, 1), opacity .7s ease;
  }
  html.intro-out .intro-overlay { transform: translateY(-100%); opacity: .6; }
  .intro-inner { width: min(720px, 86vw); text-align: center; }
  .intro-overlay svg { width: 100%; height: 120px; overflow: visible; }
  .intro-overlay .axis { stroke: var(--line); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .intro-overlay .trace {
    fill: none; stroke: var(--accent); stroke-width: 2.5; vector-effect: non-scaling-stroke;
    stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 1;
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--accent) 55%, transparent));
    animation: intro-draw 1.6s cubic-bezier(.45, 0, .25, 1) .15s forwards;
  }
  .intro-name, .intro-sub { margin: 0; opacity: 0; animation: intro-rise .6s ease forwards; }
  .intro-name { font-size: clamp(1.6rem, 4vw, 2.4rem); font-weight: 700; letter-spacing: -0.02em; margin-top: 22px; animation-delay: 1.1s; }
  .intro-sub { font-family: var(--mono); font-size: .85rem; color: var(--copper); letter-spacing: .12em; text-transform: uppercase; margin-top: 8px; animation-delay: 1.35s; }
  .intro-skip {
    position: absolute; right: 20px; bottom: 20px; font: inherit; font-family: var(--mono); font-size: .8rem;
    color: var(--muted); background: none; border: 1px solid var(--line); border-radius: 999px; padding: 6px 14px; cursor: pointer;
  }
  @keyframes intro-draw { to { stroke-dashoffset: 0; } }
  @keyframes intro-rise { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

  /* hero settles in after the overlay lifts */
  html.intro-out .hero-grid > * { animation: hero-in .8s ease both; }
  html.intro-out .hero-grid > :nth-child(2) { animation-delay: .12s; }
  @keyframes hero-in { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
</style>
