---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  title: string;
  eyebrow: string;
  meta?: string;
  summary: string;
  tags?: string[];
  cover?: ImageMetadata;
  coverUrl?: string;
  coverAlt?: string;
  placeholder?: string; // short label drawn on the placeholder when there is no photo
}
const { href, title, eyebrow, meta, summary, tags = [], cover, coverUrl, coverAlt = '', placeholder } = Astro.props;
---
<a class="card" href={href}>
  <div class="media">
    {cover ? (
      <Image src={cover} alt={coverAlt} width={720} />
    ) : coverUrl ? (
      <img src={coverUrl} alt={coverAlt} loading="lazy" />
    ) : (
      <div class="placeholder" aria-hidden="true">
        <svg viewBox="0 0 400 225" preserveAspectRatio="xMidYMid slice">
          <defs>
            <pattern id="trace" width="40" height="40" patternUnits="userSpaceOnUse">
              <path d="M0 20 H14 L20 14 H40 M20 0 V8 M20 32 V40" fill="none" stroke="currentColor" stroke-width="1.4" />
              <circle cx="20" cy="14" r="2.6" fill="currentColor" />
            </pattern>
          </defs>
          <rect width="400" height="225" fill="url(#trace)" />
        </svg>
        <span>{placeholder ?? title}</span>
      </div>
    )}
  </div>
  <div class="body">
    <span class="eyebrow">{eyebrow}</span>
    <h3>{title}</h3>
    {meta && <p class="mono muted meta">{meta}</p>}
    <p class="summary">{summary}</p>
    {tags.length > 0 && (
      <ul class="tags">
        {tags.slice(0, 5).map((t) => <li>{t}</li>)}
      </ul>
    )}
    <span class="more">Read more <span aria-hidden="true">→</span></span>
  </div>
</a>

<style>
  .card {
    display: flex; flex-direction: column;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    overflow: hidden; color: var(--text); box-shadow: var(--shadow);
    transition: transform .18s ease, border-color .18s ease;
  }
  .card:hover { text-decoration: none; transform: translateY(-3px); border-color: var(--accent); }
  .media { aspect-ratio: 16 / 9; background: var(--surface-2); overflow: hidden; }
  .media img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s ease; }
  .card:hover .media img { transform: scale(1.03); }
  .placeholder { position: relative; width: 100%; height: 100%; color: color-mix(in srgb, var(--accent) 22%, transparent); }
  .placeholder svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .placeholder span {
    position: absolute; inset: 0; display: grid; place-items: center; padding: 0 24px; text-align: center;
    font-family: var(--mono); font-weight: 600; font-size: 1.6rem; letter-spacing: 0.04em; color: var(--accent);
  }
  .body { padding: 18px 20px 20px; display: flex; flex-direction: column; flex: 1; }
  .body h3 { margin-bottom: 4px; }
  .meta { margin: 0 0 10px; }
  .summary { color: var(--muted); font-size: 0.95rem; flex: 1; }
  .more { margin-top: 14px; font-weight: 600; font-size: 0.9rem; color: var(--accent); }
</style>
